# --- Database (Supabase Postgres) -------------------------------------------
# Local Postgres (docker-compose / `pnpm dev:db`) — used when SUPABASE vars below are unset:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skolara?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/skolara?schema=public"
#
# Supabase: Project Settings → Database → Connection string.
# DATABASE_URL = "Connection pooling" URI (port 6543, transaction mode) — used by the app.
#   Append `&pgbouncer=true&connection_limit=1` (Prisma's recommended pooler settings).
# DIRECT_URL   = "Direct connection" URI (port 5432) — used only by `prisma migrate`.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Optional — only needed if SUPABASE_STORAGE_BUCKET below is set (file uploads via Supabase Storage
# instead of raw client URIs). Project Settings → API. Use the actual service_role secret key
# (starts with sb_secret_ or is a long JWT under "service_role") — not the publishable/anon key.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

# --- File uploads -----------------------------------------------------------
# With the three SUPABASE_* vars above set, uploads (payment screenshots,
# homework attachments, school logos) go to Supabase Storage and the API hands
# back a signed URL. Leave them unset and uploads fall back to local disk,
# served from GET /uploads/files/:name — fine for development, NOT for a
# deployment (container filesystems don't survive a redeploy).
#
# How long an upload's signed URL stays valid. It gets stored on the record, so
# it needs to outlive the record's useful life. Defaults to one year.
STORAGE_SIGNED_URL_TTL_SECONDS=""
# Where the local-disk fallback writes. Defaults to <api>/.uploads
STORAGE_LOCAL_DIR=""
# Public base URL of THIS API, used to build local-fallback file URLs.
# Defaults to http://localhost:$PORT
PUBLIC_API_URL=""

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000
NODE_ENV="development"

# Comma-separated browser origins allowed to call this API (e.g. your deployed
# web app's URL). Required in production — CORS is closed by default there.
# Leave unset in development to allow any origin.
CORS_ORIGINS=""

# Swagger UI (GET /docs) is on by default in development. Set to "true" to
# also expose it in production — off by default there since this is a
# multi-tenant B2B API, not a public one.
ENABLE_API_DOCS=""

# --- Push notifications (Expo) ----------------------------------------------
# Expo's push service needs no credentials for a standard project, so push is
# on by default. Set to "false" to log notifications to the console instead.
EXPO_PUSH_ENABLED=""
# Only needed if the Expo project has "Enhanced Security for Push
# Notifications" enabled (expo.dev -> project -> Access tokens).
EXPO_ACCESS_TOKEN=""

# Optional — omit both to fall back to console-logged WhatsApp alerts in development.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Optional — omit both to fall back to console-logged emails in development
# (password resets, etc. still work, just print the email instead of sending it).
# https://resend.com — RESEND_API_KEY from the dashboard, EMAIL_FROM must be a
# verified sending address/domain on that account.
RESEND_API_KEY=""
EMAIL_FROM=""

# Base URL of the deployed web app, used to build links inside emails (e.g.
# the password reset link). Defaults to http://localhost:3000 if unset.
APP_URL=""

# Optional — omit to fall back to deterministic (non-AI) report comments and risk explanations.
ANTHROPIC_API_KEY=""

# Optional — omit to disable the online payment gateway add-on (manual bank-transfer stays the default).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
