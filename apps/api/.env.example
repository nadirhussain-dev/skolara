# --- Database (Supabase Postgres) -------------------------------------------
# Local Postgres (docker-compose / `pnpm dev:db`) — used when SUPABASE vars below are unset:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skolara?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/skolara?schema=public"
#
# Supabase: Project Settings → Database → Connection string.
# DATABASE_URL = "Connection pooling" URI (port 6543, transaction mode) — used by the app.
#   Append `&pgbouncer=true&connection_limit=1` (Prisma's recommended pooler settings).
# DIRECT_URL   = "Direct connection" URI (port 5432) — used only by `prisma migrate`.
# DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Optional — only needed if SUPABASE_STORAGE_BUCKET below is set (file uploads via Supabase Storage
# instead of raw client URIs). Project Settings → API. Use the actual service_role secret key
# (starts with sb_secret_ or is a long JWT under "service_role") — not the publishable/anon key.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET=""

JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=4000

# Optional — omit both to fall back to console-logged WhatsApp alerts in development.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Optional — omit to fall back to deterministic (non-AI) report comments and risk explanations.
ANTHROPIC_API_KEY=""

# Optional — omit to disable the online payment gateway add-on (manual bank-transfer stays the default).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
