generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  REJECTED
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentSubmissionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  NEEDS_INFO
}

enum PaymentRejectionReason {
  AMOUNT_MISMATCH
  SCREENSHOT_UNCLEAR
  WRONG_ACCOUNT
  DUPLICATE_SUBMISSION
  OTHER
}

enum NoticeAudience {
  ALL
  TEACHERS
  PARENTS
  STUDENTS
  CLASS
}

model School {
  id                 String              @id @default(uuid())
  name                String
  subdomain           String              @unique
  plan                SubscriptionPlan    @default(BASIC)
  subscriptionStatus  SubscriptionStatus  @default(PENDING)
  trialEndsAt         DateTime?
  logoUrl             String?
  primaryColor        String?
  createdAt           DateTime            @default(now())

  users               User[]
  classes             SchoolClass[]
  studentProfiles     StudentProfile[]
  teacherProfiles     TeacherProfile[]
  attendanceRecords   AttendanceRecord[]
  invoices            Invoice[]
  paymentSubmissions  PaymentSubmission[]
  paymentReferenceSeqs PaymentReferenceSequence[]
  gradeEntries        GradeEntry[]
  notices             Notice[]
}

model User {
  id            String    @id @default(uuid())
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id])
  role          Role
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
  markedAttendance        AttendanceRecord[] @relation("MarkedByUser")
  submittedPayments       PaymentSubmission[] @relation("SubmittedByUser")
  reviewedPayments        PaymentSubmission[] @relation("ReviewedByUser")
  children                ParentStudentLink[]
  gradedEntries           GradeEntry[]        @relation("GradedByUser")
  publishedNotices        Notice[]            @relation("PublishedByUser")

  @@index([schoolId])
}

// Join table backing the parent-facing multi-child switcher: one PARENT user
// can link to several StudentProfiles (siblings at the same or different school).
model ParentStudentLink {
  parentUserId  String
  parentUser    User           @relation(fields: [parentUserId], references: [id])
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])

  @@id([parentUserId, studentId])
  @@index([studentId])
}

model SchoolClass {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  name           String
  section        String
  academicYear   String
  classTeacherId String?

  students           StudentProfile[]
  attendanceRecords  AttendanceRecord[]
  gradeEntries       GradeEntry[]
  notices            Notice[]

  @@index([schoolId])
}

model StudentProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  classId          String?
  class            SchoolClass? @relation(fields: [classId], references: [id])
  admissionNumber  String
  dateOfBirth      DateTime

  attendanceRecords  AttendanceRecord[]
  invoices           Invoice[]
  paymentSubmissions PaymentSubmission[]
  parentLinks        ParentStudentLink[]
  gradeEntries       GradeEntry[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([classId])
}

model TeacherProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  employeeNumber  String
  subjects        String[]

  @@unique([schoolId, employeeNumber])
  @@index([schoolId])
}

model AttendanceRecord {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id])
  classId         String
  class           SchoolClass       @relation(fields: [classId], references: [id])
  studentId       String
  student         StudentProfile    @relation(fields: [studentId], references: [id])
  date            DateTime
  status          AttendanceStatus
  markedByUserId  String
  markedByUser    User              @relation("MarkedByUser", fields: [markedByUserId], references: [id])
  markedOffline   Boolean           @default(false)
  createdAt       DateTime          @default(now())

  @@unique([classId, studentId, date])
  @@index([schoolId])
  @@index([studentId])
}

model Invoice {
  id          String        @id @default(uuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id])
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  term        String
  amountDue   Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(12, 2)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime

  paymentSubmissions  PaymentSubmission[]

  @@index([schoolId])
  @@index([studentId])
}

model PaymentSubmission {
  id                 String                    @id @default(uuid())
  referenceId        String                    @unique
  schoolId           String
  school             School                    @relation(fields: [schoolId], references: [id])
  studentId          String
  student            StudentProfile            @relation(fields: [studentId], references: [id])
  invoiceId          String
  invoice            Invoice                   @relation(fields: [invoiceId], references: [id])
  submittedByUserId  String
  submittedByUser    User                      @relation("SubmittedByUser", fields: [submittedByUserId], references: [id])
  amountClaimed      Decimal                   @db.Decimal(12, 2)
  screenshotUrl      String
  status             PaymentSubmissionStatus   @default(PENDING_VERIFICATION)
  rejectionReason    PaymentRejectionReason?
  reviewNote         String?
  reviewedByUserId   String?
  reviewedByUser     User?                     @relation("ReviewedByUser", fields: [reviewedByUserId], references: [id])
  reviewedAt         DateTime?
  createdAt          DateTime                  @default(now())

  @@index([schoolId, status])
  @@index([studentId])
}

// Backs an atomic per-school, per-year counter so payment reference IDs
// (e.g. SKL-2026-000482) never collide under concurrent submissions.
model PaymentReferenceSequence {
  schoolId      String
  school        School @relation(fields: [schoolId], references: [id])
  year          Int
  lastSequence  Int    @default(0)

  @@id([schoolId, year])
}

model GradeEntry {
  id              String         @id @default(uuid())
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id])
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id])
  classId         String
  class           SchoolClass    @relation(fields: [classId], references: [id])
  subject         String
  term            String
  examType        String
  marksObtained   Decimal        @db.Decimal(6, 2)
  maxMarks        Decimal        @db.Decimal(6, 2)
  comments        String?
  gradedByUserId  String
  gradedByUser    User           @relation("GradedByUser", fields: [gradedByUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([studentId, subject, term, examType])
  @@index([schoolId])
  @@index([classId])
}

model Notice {
  id                String         @id @default(uuid())
  schoolId          String
  school            School         @relation(fields: [schoolId], references: [id])
  title             String
  body              String
  audience          NoticeAudience @default(ALL)
  classId           String?
  class             SchoolClass?   @relation(fields: [classId], references: [id])
  publishedByUserId String
  publishedByUser   User           @relation("PublishedByUser", fields: [publishedByUserId], references: [id])
  createdAt         DateTime       @default(now())

  @@index([schoolId, createdAt])
  @@index([classId])
}
