generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase's pooled (pgbouncer, port 6543) connection — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Supabase's direct (port 5432) connection — used only for running migrations,
  // since the transaction pooler can't hold the advisory locks `migrate` needs.
  directUrl = env("DIRECT_URL")
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  REJECTED
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentSubmissionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  NEEDS_INFO
}

enum PaymentRejectionReason {
  AMOUNT_MISMATCH
  SCREENSHOT_UNCLEAR
  WRONG_ACCOUNT
  DUPLICATE_SUBMISSION
  OTHER
}

enum NoticeAudience {
  ALL
  TEACHERS
  PARENTS
  STUDENTS
  CLASS
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model School {
  id                 String              @id @default(uuid())
  name                String
  subdomain           String              @unique
  plan                SubscriptionPlan    @default(BASIC)
  subscriptionStatus  SubscriptionStatus  @default(PENDING)
  trialEndsAt         DateTime?
  logoUrl             String?
  primaryColor        String?
  schoolGroupId       String?
  schoolGroup         SchoolGroup?        @relation(fields: [schoolGroupId], references: [id])
  createdAt           DateTime            @default(now())

  users               User[]
  classes             SchoolClass[]
  studentProfiles     StudentProfile[]
  teacherProfiles     TeacherProfile[]
  attendanceRecords   AttendanceRecord[]
  invoices            Invoice[]
  paymentSubmissions  PaymentSubmission[]
  paymentReferenceSeqs PaymentReferenceSequence[]
  gradeEntries        GradeEntry[]
  notices             Notice[]
  assignments         Assignment[]
  messageThreads      MessageThread[]
  complaints          Complaint[]
  bankStatementLines  BankStatementLine[]
  exams               Exam[]
  books               Book[]
  bookLoans           BookLoan[]
  buses               Bus[]
  payslips            Payslip[]
  apiKeys             ApiKey[]

  @@index([schoolGroupId])
}

model User {
  id            String    @id @default(uuid())
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id])
  role          Role
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
  markedAttendance        AttendanceRecord[] @relation("MarkedByUser")
  submittedPayments       PaymentSubmission[] @relation("SubmittedByUser")
  reviewedPayments        PaymentSubmission[] @relation("ReviewedByUser")
  children                ParentStudentLink[]
  gradedEntries           GradeEntry[]        @relation("GradedByUser")
  publishedNotices        Notice[]            @relation("PublishedByUser")
  createdAssignments      Assignment[]        @relation("CreatedByUser")
  teacherThreads          MessageThread[]     @relation("ThreadTeacher")
  parentThreads           MessageThread[]     @relation("ThreadParent")
  sentMessages            Message[]           @relation("SentMessages")
  raisedComplaints        Complaint[]         @relation("RaisedByUser")
  complaintComments       ComplaintComment[]
  payslips                Payslip[]           @relation("StaffPayslips")
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  deviceTokens            DeviceToken[]

  @@index([schoolId])
}

// Server-side tracking for issued refresh tokens, so logout and rotation can
// actually invalidate a token instead of it just being a stateless JWT that's
// valid until natural expiry regardless of what the client does with it.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  // SHA-256 of the raw token — high-entropy already, so a fast hash is
  // appropriate here (unlike passwords, which need a slow one).
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Single-use, short-lived tokens for the forgot-password flow. Same hashing
// rationale as RefreshToken — the raw token is high-entropy and only ever
// mailed to the user, so a fast hash is fine for the stored copy.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Join table backing the parent-facing multi-child switcher: one PARENT user
// can link to several StudentProfiles (siblings at the same or different school).
model ParentStudentLink {
  parentUserId  String
  parentUser    User           @relation(fields: [parentUserId], references: [id])
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])

  @@id([parentUserId, studentId])
  @@index([studentId])
}

model SchoolClass {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  name           String
  section        String
  academicYear   String
  classTeacherId String?

  students           StudentProfile[]
  attendanceRecords  AttendanceRecord[]
  gradeEntries       GradeEntry[]
  notices            Notice[]
  assignments        Assignment[]
  exams              Exam[]

  @@index([schoolId])
}

model StudentProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  classId          String?
  class            SchoolClass? @relation(fields: [classId], references: [id])
  admissionNumber  String
  dateOfBirth      DateTime

  attendanceRecords  AttendanceRecord[]
  invoices           Invoice[]
  paymentSubmissions PaymentSubmission[]
  parentLinks        ParentStudentLink[]
  gradeEntries       GradeEntry[]
  assignmentSubmissions AssignmentSubmission[]
  messageThreads     MessageThread[]
  complaints         Complaint[]
  bookLoans          BookLoan[]
  busAssignment      BusAssignment?

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([classId])
}

model TeacherProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  employeeNumber  String
  subjects        String[]

  @@unique([schoolId, employeeNumber])
  @@index([schoolId])
}

model AttendanceRecord {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id])
  classId         String
  class           SchoolClass       @relation(fields: [classId], references: [id])
  studentId       String
  student         StudentProfile    @relation(fields: [studentId], references: [id])
  date            DateTime
  status          AttendanceStatus
  markedByUserId  String
  markedByUser    User              @relation("MarkedByUser", fields: [markedByUserId], references: [id])
  markedOffline   Boolean           @default(false)
  createdAt       DateTime          @default(now())

  @@unique([classId, studentId, date])
  @@index([schoolId])
  @@index([studentId])
}

model Invoice {
  id          String        @id @default(uuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id])
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  term        String
  amountDue   Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(12, 2)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime

  paymentSubmissions  PaymentSubmission[]

  @@index([schoolId])
  @@index([studentId])
}

model PaymentSubmission {
  id                 String                    @id @default(uuid())
  referenceId        String                    @unique
  schoolId           String
  school             School                    @relation(fields: [schoolId], references: [id])
  studentId          String
  student            StudentProfile            @relation(fields: [studentId], references: [id])
  invoiceId          String
  invoice            Invoice                   @relation(fields: [invoiceId], references: [id])
  submittedByUserId  String
  submittedByUser    User                      @relation("SubmittedByUser", fields: [submittedByUserId], references: [id])
  amountClaimed      Decimal                   @db.Decimal(12, 2)
  screenshotUrl      String
  status             PaymentSubmissionStatus   @default(PENDING_VERIFICATION)
  rejectionReason    PaymentRejectionReason?
  reviewNote         String?
  reviewedByUserId   String?
  reviewedByUser     User?                     @relation("ReviewedByUser", fields: [reviewedByUserId], references: [id])
  reviewedAt         DateTime?
  createdAt          DateTime                  @default(now())
  matchedBankStatementLine BankStatementLine?

  @@index([schoolId, status])
  @@index([studentId])
}

// Backs an atomic per-school, per-year counter so payment reference IDs
// (e.g. SKL-2026-000482) never collide under concurrent submissions.
model PaymentReferenceSequence {
  schoolId      String
  school        School @relation(fields: [schoolId], references: [id])
  year          Int
  lastSequence  Int    @default(0)

  @@id([schoolId, year])
}

model GradeEntry {
  id              String         @id @default(uuid())
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id])
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id])
  classId         String
  class           SchoolClass    @relation(fields: [classId], references: [id])
  subject         String
  term            String
  examType        String
  marksObtained   Decimal        @db.Decimal(6, 2)
  maxMarks        Decimal        @db.Decimal(6, 2)
  comments        String?
  gradedByUserId  String
  gradedByUser    User           @relation("GradedByUser", fields: [gradedByUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([studentId, subject, term, examType])
  @@index([schoolId])
  @@index([classId])
}

model Notice {
  id                String         @id @default(uuid())
  schoolId          String
  school            School         @relation(fields: [schoolId], references: [id])
  title             String
  body              String
  audience          NoticeAudience @default(ALL)
  classId           String?
  class             SchoolClass?   @relation(fields: [classId], references: [id])
  publishedByUserId String
  publishedByUser   User           @relation("PublishedByUser", fields: [publishedByUserId], references: [id])
  createdAt         DateTime       @default(now())

  @@index([schoolId, createdAt])
  @@index([classId])
}

model SchoolGroup {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  schools School[]
}

model Assignment {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  classId         String
  class           SchoolClass @relation(fields: [classId], references: [id])
  subject         String
  title           String
  description     String?
  dueDate         DateTime
  createdByUserId String
  createdByUser   User     @relation("CreatedByUser", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  submissions AssignmentSubmission[]

  @@index([schoolId])
  @@index([classId])
}

model AssignmentSubmission {
  id           String    @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id])
  fileUrl      String
  note         String?
  grade        String?
  feedback     String?
  submittedAt  DateTime  @default(now())

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model MessageThread {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  teacherUserId String
  teacherUser   User     @relation("ThreadTeacher", fields: [teacherUserId], references: [id])
  parentUserId  String
  parentUser    User     @relation("ThreadParent", fields: [parentUserId], references: [id])
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([studentId, teacherUserId, parentUserId])
  @@index([schoolId])
}

model Message {
  id        String   @id @default(uuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id])
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model Complaint {
  id             String          @id @default(uuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  raisedByUserId String
  raisedByUser   User            @relation("RaisedByUser", fields: [raisedByUserId], references: [id])
  studentId      String?
  student        StudentProfile? @relation(fields: [studentId], references: [id])
  subject        String
  body           String
  status         ComplaintStatus @default(OPEN)
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  comments ComplaintComment[]

  @@index([schoolId, status])
}

model ComplaintComment {
  id           String    @id @default(uuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id])
  authorUserId String
  authorUser   User      @relation(fields: [authorUserId], references: [id])
  body         String
  createdAt    DateTime  @default(now())

  @@index([complaintId])
}

// Parsed lines from a school-uploaded bank statement CSV, used to suggest
// matches against PENDING_VERIFICATION payment submissions by amount.
model BankStatementLine {
  id                       String             @id @default(uuid())
  schoolId                 String
  school                   School             @relation(fields: [schoolId], references: [id])
  transactionDate          DateTime
  amount                   Decimal            @db.Decimal(12, 2)
  description              String
  matchedPaymentSubmissionId String?          @unique
  matchedPaymentSubmission  PaymentSubmission? @relation(fields: [matchedPaymentSubmissionId], references: [id])
  importedAt               DateTime           @default(now())

  @@index([schoolId])
}

model Exam {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  classId       String
  class         SchoolClass @relation(fields: [classId], references: [id])
  name          String
  term          String
  examType      String
  scheduledDate DateTime

  @@index([schoolId])
  @@index([classId])
}

model Book {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  title           String
  author          String
  isbn            String?
  totalCopies     Int
  availableCopies Int

  loans BookLoan[]

  @@index([schoolId])
}

model BookLoan {
  id         String    @id @default(uuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id])
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id])
  borrowedAt DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?

  @@index([schoolId])
  @@index([bookId])
  @@index([studentId])
}

model Bus {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  plateNumber  String
  driverName   String
  driverPhone  String?
  routeName    String

  assignments BusAssignment[]
  locationPings BusLocationPing[]

  @@index([schoolId])
}

model BusAssignment {
  busId     String
  bus       Bus            @relation(fields: [busId], references: [id])
  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id])

  @@id([busId, studentId])
}

model BusLocationPing {
  id         String   @id @default(uuid())
  busId      String
  bus        Bus      @relation(fields: [busId], references: [id])
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  @@index([busId, recordedAt])
}

model Payslip {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  staffUserId  String
  staffUser    User     @relation("StaffPayslips", fields: [staffUserId], references: [id])
  month        String
  basicSalary  Decimal  @db.Decimal(12, 2)
  deductions   Decimal  @default(0) @db.Decimal(12, 2)
  netPay       Decimal  @db.Decimal(12, 2)
  generatedAt  DateTime @default(now())

  @@unique([staffUserId, month])
  @@index([schoolId])
}

model ApiKey {
  id         String    @id @default(uuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  name       String
  keyPrefix  String
  hashedKey  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([schoolId])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// One row per install of the mobile app that a user has signed into. Tokens
// are rotated by the OS and can be revoked at any time, so `lastSeenAt` lets
// stale rows be pruned and the push provider's "not registered" errors are
// treated as a signal to delete rather than an error to retry.
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  @@index([userId])
}
