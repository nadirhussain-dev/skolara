generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Supabase's pooled (pgbouncer, port 6543) connection — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Supabase's direct (port 5432) connection — used only for running migrations,
  // since the transaction pooler can't hold the advisory locks `migrate` needs.
  directUrl = env("DIRECT_URL")
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum SubscriptionStatus {
  PENDING
  TRIAL
  ACTIVE
  EXPIRED
  SUSPENDED
  REJECTED
}

enum Role {
  SUPER_ADMIN
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  OVERDUE
}

enum PaymentSubmissionStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  NEEDS_INFO
}

enum PaymentRejectionReason {
  AMOUNT_MISMATCH
  SCREENSHOT_UNCLEAR
  WRONG_ACCOUNT
  DUPLICATE_SUBMISSION
  OTHER
}

enum NoticeAudience {
  ALL
  TEACHERS
  PARENTS
  STUDENTS
  CLASS
}

enum ComplaintStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model School {
  id                 String              @id @default(uuid())
  name                String
  subdomain           String              @unique
  plan                SubscriptionPlan    @default(BASIC)
  subscriptionStatus  SubscriptionStatus  @default(PENDING)
  trialEndsAt         DateTime?
  logoUrl             String?
  primaryColor        String?
  schoolGroupId       String?
  schoolGroup         SchoolGroup?        @relation(fields: [schoolGroupId], references: [id])
  createdAt           DateTime            @default(now())

  users               User[]
  classes             SchoolClass[]
  studentProfiles     StudentProfile[]
  teacherProfiles     TeacherProfile[]
  attendanceRecords   AttendanceRecord[]
  invoices            Invoice[]
  paymentSubmissions  PaymentSubmission[]
  paymentReferenceSeqs PaymentReferenceSequence[]
  gradeEntries        GradeEntry[]
  notices             Notice[]
  assignments         Assignment[]
  messageThreads      MessageThread[]
  complaints          Complaint[]
  bankStatementLines  BankStatementLine[]
  exams               Exam[]
  books               Book[]
  bookLoans           BookLoan[]
  buses               Bus[]
  payslips            Payslip[]
  apiKeys             ApiKey[]
  periods             Period[]
  timetableEntries    TimetableEntry[]
  calendarEvents      CalendarEvent[]
  leaveRequests       LeaveRequest[]
  meetingSlots        MeetingSlot[]
  supportTickets      SupportTicket[]
  studyMaterials      StudyMaterial[]
  quizzes             Quiz[]
  quizAttempts        QuizAttempt[]
  syllabusTopics      SyllabusTopic[]
  lessonPlans         LessonPlan[]
  liveClasses         LiveClass[]
  auditLogs           AuditLog[]

  @@index([schoolGroupId])
}

model User {
  id            String    @id @default(uuid())
  schoolId      String?
  school        School?   @relation(fields: [schoolId], references: [id])
  role          Role
  // Unique per school, not globally — the same person can legitimately hold a
  // parent account at one school and a teacher account at another. Platform
  // admins (schoolId null) are kept unique by a partial index; see the
  // per_school_email_uniqueness migration.
  email         String
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  studentProfile          StudentProfile?
  teacherProfile          TeacherProfile?
  markedAttendance        AttendanceRecord[] @relation("MarkedByUser")
  submittedPayments       PaymentSubmission[] @relation("SubmittedByUser")
  reviewedPayments        PaymentSubmission[] @relation("ReviewedByUser")
  children                ParentStudentLink[]
  gradedEntries           GradeEntry[]        @relation("GradedByUser")
  publishedNotices        Notice[]            @relation("PublishedByUser")
  createdAssignments      Assignment[]        @relation("CreatedByUser")
  teacherThreads          MessageThread[]     @relation("ThreadTeacher")
  parentThreads           MessageThread[]     @relation("ThreadParent")
  sentMessages            Message[]           @relation("SentMessages")
  raisedComplaints        Complaint[]         @relation("RaisedByUser")
  complaintComments       ComplaintComment[]
  payslips                Payslip[]           @relation("StaffPayslips")
  refreshTokens           RefreshToken[]
  passwordResetTokens     PasswordResetToken[]
  deviceTokens            DeviceToken[]
  timetableLessons        TimetableEntry[]    @relation("TimetableTeacher")
  authoredCalendarEvents  CalendarEvent[]     @relation("CalendarEventAuthor")
  leaveRequests           LeaveRequest[]      @relation("LeaveRequester")
  reviewedLeaveRequests   LeaveRequest[]      @relation("LeaveReviewer")
  offeredMeetingSlots     MeetingSlot[]       @relation("MeetingTeacher")
  bookedMeetingSlots      MeetingSlot[]       @relation("MeetingParent")
  raisedSupportTickets    SupportTicket[]        @relation("SupportRaiser")
  supportTicketComments   SupportTicketComment[] @relation("SupportCommenter")
  platformBroadcasts      PlatformBroadcast[]    @relation("BroadcastAuthor")
  uploadedStudyMaterials  StudyMaterial[]        @relation("StudyMaterialUploader")
  authoredQuizzes         Quiz[]                 @relation("QuizAuthor")
  authoredSyllabusTopics  SyllabusTopic[]        @relation("SyllabusAuthor")
  lessonPlans             LessonPlan[]           @relation("LessonPlanTeacher")
  hostedLiveClasses       LiveClass[]            @relation("LiveClassHost")
  auditLogs               AuditLog[]          @relation("AuditActor")
  classAssignments        ClassTeacher[]      @relation("ClassTeachers")

  @@unique([schoolId, email])
  @@index([schoolId])
  @@index([email])
  // Platform admins have a null schoolId, and Postgres treats nulls as
  // distinct in a unique constraint, so the composite above doesn't stop two
  // of them sharing an address. That's covered by a partial unique index
  // created in the per_school_email_uniqueness migration — Prisma can't
  // express partial indexes for PostgreSQL, so it lives in SQL only.
}

// Server-side tracking for issued refresh tokens, so logout and rotation can
// actually invalidate a token instead of it just being a stateless JWT that's
// valid until natural expiry regardless of what the client does with it.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  // SHA-256 of the raw token — high-entropy already, so a fast hash is
  // appropriate here (unlike passwords, which need a slow one).
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Single-use, short-lived tokens for the forgot-password flow. Same hashing
// rationale as RefreshToken — the raw token is high-entropy and only ever
// mailed to the user, so a fast hash is fine for the stored copy.
model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Join table backing the parent-facing multi-child switcher: one PARENT user
// can link to several StudentProfiles (siblings at the same or different school).
model ParentStudentLink {
  parentUserId  String
  parentUser    User           @relation(fields: [parentUserId], references: [id])
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])

  @@id([parentUserId, studentId])
  @@index([studentId])
}

model SchoolClass {
  id             String   @id @default(uuid())
  schoolId       String
  school         School   @relation(fields: [schoolId], references: [id])
  name           String
  section        String
  academicYear   String
  classTeacherId String?

  students           StudentProfile[]
  attendanceRecords  AttendanceRecord[]
  gradeEntries       GradeEntry[]
  notices            Notice[]
  assignments        Assignment[]
  exams              Exam[]
  classTeachers      ClassTeacher[]
  timetableEntries   TimetableEntry[]
  calendarEvents     CalendarEvent[]
  studyMaterials     StudyMaterial[]
  quizzes            Quiz[]
  syllabusTopics     SyllabusTopic[]
  lessonPlans        LessonPlan[]
  liveClasses        LiveClass[]

  @@unique([schoolId, name, section, academicYear])
  @@index([schoolId])
}

model StudentProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  classId          String?
  class            SchoolClass? @relation(fields: [classId], references: [id])
  admissionNumber  String
  dateOfBirth      DateTime

  attendanceRecords  AttendanceRecord[]
  invoices           Invoice[]
  paymentSubmissions PaymentSubmission[]
  parentLinks        ParentStudentLink[]
  gradeEntries       GradeEntry[]
  assignmentSubmissions AssignmentSubmission[]
  messageThreads     MessageThread[]
  complaints         Complaint[]
  bookLoans          BookLoan[]
  busAssignment      BusAssignment?
  meetingSlots       MeetingSlot[]
  quizAttempts       QuizAttempt[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@index([classId])
}

model TeacherProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  employeeNumber  String
  subjects        String[]

  @@unique([schoolId, employeeNumber])
  @@index([schoolId])
}

model AttendanceRecord {
  id              String            @id @default(uuid())
  schoolId        String
  school          School            @relation(fields: [schoolId], references: [id])
  classId         String
  class           SchoolClass       @relation(fields: [classId], references: [id])
  studentId       String
  student         StudentProfile    @relation(fields: [studentId], references: [id])
  date            DateTime
  status          AttendanceStatus
  markedByUserId  String
  markedByUser    User              @relation("MarkedByUser", fields: [markedByUserId], references: [id])
  markedOffline   Boolean           @default(false)
  createdAt       DateTime          @default(now())

  @@unique([classId, studentId, date])
  @@index([schoolId])
  @@index([studentId])
}

model Invoice {
  id          String        @id @default(uuid())
  schoolId    String
  school      School        @relation(fields: [schoolId], references: [id])
  studentId   String
  student     StudentProfile @relation(fields: [studentId], references: [id])
  term        String
  amountDue   Decimal       @db.Decimal(12, 2)
  amountPaid  Decimal       @default(0) @db.Decimal(12, 2)
  status      InvoiceStatus @default(UNPAID)
  dueDate     DateTime

  paymentSubmissions  PaymentSubmission[]

  @@index([schoolId])
  @@index([studentId])
}

model PaymentSubmission {
  id                 String                    @id @default(uuid())
  referenceId        String                    @unique
  schoolId           String
  school             School                    @relation(fields: [schoolId], references: [id])
  studentId          String
  student            StudentProfile            @relation(fields: [studentId], references: [id])
  invoiceId          String
  invoice            Invoice                   @relation(fields: [invoiceId], references: [id])
  submittedByUserId  String
  submittedByUser    User                      @relation("SubmittedByUser", fields: [submittedByUserId], references: [id])
  amountClaimed      Decimal                   @db.Decimal(12, 2)
  screenshotUrl      String
  status             PaymentSubmissionStatus   @default(PENDING_VERIFICATION)
  rejectionReason    PaymentRejectionReason?
  reviewNote         String?
  reviewedByUserId   String?
  reviewedByUser     User?                     @relation("ReviewedByUser", fields: [reviewedByUserId], references: [id])
  reviewedAt         DateTime?
  // Rendered when the submission is verified. Null until then — a receipt for
  // an unverified payment would be a receipt for money the school hasn't
  // confirmed receiving.
  receiptUrl         String?
  createdAt          DateTime                  @default(now())
  matchedBankStatementLine BankStatementLine?

  @@index([schoolId, status])
  @@index([studentId])
}

// Backs an atomic per-school, per-year counter so payment reference IDs
// (e.g. SKL-2026-000482) never collide under concurrent submissions.
model PaymentReferenceSequence {
  schoolId      String
  school        School @relation(fields: [schoolId], references: [id])
  year          Int
  lastSequence  Int    @default(0)

  @@id([schoolId, year])
}

model GradeEntry {
  id              String         @id @default(uuid())
  schoolId        String
  school          School         @relation(fields: [schoolId], references: [id])
  studentId       String
  student         StudentProfile @relation(fields: [studentId], references: [id])
  classId         String
  class           SchoolClass    @relation(fields: [classId], references: [id])
  subject         String
  term            String
  examType        String
  marksObtained   Decimal        @db.Decimal(6, 2)
  maxMarks        Decimal        @db.Decimal(6, 2)
  comments        String?
  gradedByUserId  String
  gradedByUser    User           @relation("GradedByUser", fields: [gradedByUserId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@unique([studentId, subject, term, examType])
  @@index([schoolId])
  @@index([classId])
}

model Notice {
  id                String         @id @default(uuid())
  schoolId          String
  school            School         @relation(fields: [schoolId], references: [id])
  title             String
  body              String
  audience          NoticeAudience @default(ALL)
  classId           String?
  class             SchoolClass?   @relation(fields: [classId], references: [id])
  publishedByUserId String
  publishedByUser   User           @relation("PublishedByUser", fields: [publishedByUserId], references: [id])
  createdAt         DateTime       @default(now())

  @@index([schoolId, createdAt])
  @@index([classId])
}

model SchoolGroup {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  schools School[]
}

model Assignment {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  classId         String
  class           SchoolClass @relation(fields: [classId], references: [id])
  subject         String
  title           String
  description     String?
  dueDate         DateTime
  createdByUserId String
  createdByUser   User     @relation("CreatedByUser", fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  submissions AssignmentSubmission[]

  @@index([schoolId])
  @@index([classId])
}

model AssignmentSubmission {
  id           String    @id @default(uuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String
  student      StudentProfile @relation(fields: [studentId], references: [id])
  fileUrl      String
  note         String?
  grade        String?
  feedback     String?
  submittedAt  DateTime  @default(now())

  @@unique([assignmentId, studentId])
  @@index([studentId])
}

model MessageThread {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  studentId     String
  student       StudentProfile @relation(fields: [studentId], references: [id])
  teacherUserId String
  teacherUser   User     @relation("ThreadTeacher", fields: [teacherUserId], references: [id])
  parentUserId  String
  parentUser    User     @relation("ThreadParent", fields: [parentUserId], references: [id])
  createdAt     DateTime @default(now())

  messages Message[]

  @@unique([studentId, teacherUserId, parentUserId])
  @@index([schoolId])
}

model Message {
  id        String   @id @default(uuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id])
  senderId  String
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model Complaint {
  id             String          @id @default(uuid())
  schoolId       String
  school         School          @relation(fields: [schoolId], references: [id])
  raisedByUserId String
  raisedByUser   User            @relation("RaisedByUser", fields: [raisedByUserId], references: [id])
  studentId      String?
  student        StudentProfile? @relation(fields: [studentId], references: [id])
  subject        String
  body           String
  status         ComplaintStatus @default(OPEN)
  createdAt      DateTime        @default(now())
  resolvedAt     DateTime?

  comments ComplaintComment[]

  @@index([schoolId, status])
}

model ComplaintComment {
  id           String    @id @default(uuid())
  complaintId  String
  complaint    Complaint @relation(fields: [complaintId], references: [id])
  authorUserId String
  authorUser   User      @relation(fields: [authorUserId], references: [id])
  body         String
  createdAt    DateTime  @default(now())

  @@index([complaintId])
}

// Parsed lines from a school-uploaded bank statement CSV, used to suggest
// matches against PENDING_VERIFICATION payment submissions by amount.
model BankStatementLine {
  id                       String             @id @default(uuid())
  schoolId                 String
  school                   School             @relation(fields: [schoolId], references: [id])
  transactionDate          DateTime
  amount                   Decimal            @db.Decimal(12, 2)
  description              String
  matchedPaymentSubmissionId String?          @unique
  matchedPaymentSubmission  PaymentSubmission? @relation(fields: [matchedPaymentSubmissionId], references: [id])
  importedAt               DateTime           @default(now())

  @@index([schoolId])
}

model Exam {
  id            String   @id @default(uuid())
  schoolId      String
  school        School   @relation(fields: [schoolId], references: [id])
  classId       String
  class         SchoolClass @relation(fields: [classId], references: [id])
  name          String
  term          String
  examType      String
  scheduledDate DateTime

  @@index([schoolId])
  @@index([classId])
}

model Book {
  id              String   @id @default(uuid())
  schoolId        String
  school          School   @relation(fields: [schoolId], references: [id])
  title           String
  author          String
  isbn            String?
  totalCopies     Int
  availableCopies Int

  loans BookLoan[]

  @@index([schoolId])
}

model BookLoan {
  id         String    @id @default(uuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  bookId     String
  book       Book      @relation(fields: [bookId], references: [id])
  studentId  String
  student    StudentProfile @relation(fields: [studentId], references: [id])
  borrowedAt DateTime  @default(now())
  dueAt      DateTime
  returnedAt DateTime?

  @@index([schoolId])
  @@index([bookId])
  @@index([studentId])
}

model Bus {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  plateNumber  String
  driverName   String
  driverPhone  String?
  routeName    String

  assignments BusAssignment[]
  locationPings BusLocationPing[]

  @@index([schoolId])
}

model BusAssignment {
  busId     String
  bus       Bus            @relation(fields: [busId], references: [id])
  studentId String         @unique
  student   StudentProfile @relation(fields: [studentId], references: [id])

  @@id([busId, studentId])
}

model BusLocationPing {
  id         String   @id @default(uuid())
  busId      String
  bus        Bus      @relation(fields: [busId], references: [id])
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  @@index([busId, recordedAt])
}

model Payslip {
  id           String   @id @default(uuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id])
  staffUserId  String
  staffUser    User     @relation("StaffPayslips", fields: [staffUserId], references: [id])
  month        String
  basicSalary  Decimal  @db.Decimal(12, 2)
  deductions   Decimal  @default(0) @db.Decimal(12, 2)
  netPay       Decimal  @db.Decimal(12, 2)
  generatedAt  DateTime @default(now())

  @@unique([staffUserId, month])
  @@index([schoolId])
}

model ApiKey {
  id         String    @id @default(uuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id])
  name       String
  keyPrefix  String
  hashedKey  String    @unique
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([schoolId])
}

enum DevicePlatform {
  IOS
  ANDROID
  WEB
}

// One row per install of the mobile app that a user has signed into. Tokens
// are rotated by the OS and can be revoked at any time, so `lastSeenAt` lets
// stale rows be pruned and the push provider's "not registered" errors are
// treated as a signal to delete rather than an error to retry.
model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime       @default(now())

  @@index([userId])
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

// Append-only record of every state-changing request. Written by
// AuditInterceptor rather than by each service, so a new endpoint is covered
// the moment it exists instead of whenever someone remembers to instrument it.
model AuditLog {
  id           String       @id @default(uuid())
  // Null for platform-level actions by a SUPER_ADMIN, who sits outside any school.
  schoolId     String?
  school       School?      @relation(fields: [schoolId], references: [id])
  // Null when the actor was an API key or an unauthenticated request.
  actorUserId  String?
  actorUser    User?        @relation("AuditActor", fields: [actorUserId], references: [id])
  // Survives the actor being deleted, and names non-user actors (e.g. "api-key:<id>").
  actorLabel   String
  actorRole    String?
  action       String
  method       String
  path         String
  entityId     String?
  outcome      AuditOutcome
  statusCode   Int
  ipAddress    String?
  metadata     Json?
  createdAt    DateTime     @default(now())

  @@index([schoolId, createdAt])
  @@index([actorUserId])
}

// Which classes a teacher is responsible for. A teacher usually takes several
// classes and a class is usually taught by several teachers, so this is a
// join table rather than the single `SchoolClass.classTeacherId` column —
// that one names the form teacher, this one governs who may act on the class.
model ClassTeacher {
  classId       String
  class         SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherUserId String
  teacherUser   User        @relation("ClassTeachers", fields: [teacherUserId], references: [id], onDelete: Cascade)
  assignedAt    DateTime    @default(now())

  @@id([classId, teacherUserId])
  @@index([teacherUserId])
}

// ISO-8601 day numbering, declared Monday-first so Postgres orders a week
// correctly by the enum's own declaration order. Saturday is a normal teaching
// day in much of Pakistan, so the week deliberately runs Monday–Sunday rather
// than assuming a five-day week.
enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum CalendarEventCategory {
  HOLIDAY
  EXAM
  MEETING
  ACTIVITY
  TERM_START
  TERM_END
  OTHER
}

// A named slot in the school's teaching day — "Period 1", 08:00–08:45.
//
// Times are wall-clock strings ("HH:MM"), not DateTime: a period repeats every
// week and has no single instant attached. Storing a DateTime would drag a
// meaningless date along with it and invite timezone bugs on a field where the
// timezone is always "whatever the school's clock says".
model Period {
  id        String @id @default(uuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id])
  name      String
  startTime String
  endTime   String
  // Explicit ordering rather than sorting on startTime, so a school can place
  // a break or an assembly wherever it belongs in the day.
  sortOrder Int

  entries     TimetableEntry[]
  lessonPlans LessonPlan[]

  @@unique([schoolId, name])
  @@index([schoolId, sortOrder])
}

// One lesson: a class, on a day, in a period, taught by someone.
//
// The two unique constraints are the conflict detection. Enforcing them in the
// database rather than only in the service means two admins editing the
// timetable at the same time can't both win — the second write fails rather
// than silently double-booking a teacher.
model TimetableEntry {
  id            String      @id @default(uuid())
  schoolId      String
  school        School      @relation(fields: [schoolId], references: [id])
  classId       String
  class         SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  periodId      String
  period        Period      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  dayOfWeek     DayOfWeek
  subject       String
  teacherUserId String
  teacherUser   User        @relation("TimetableTeacher", fields: [teacherUserId], references: [id])
  room          String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  // A class can only be in one lesson at a time.
  @@unique([classId, dayOfWeek, periodId])
  // A teacher can only be in one place at a time.
  @@unique([teacherUserId, dayOfWeek, periodId])
  // Room clashes are enforced too, but as a partial unique index over
  // non-null rooms — see the migration. Prisma can't express a partial index,
  // so it isn't declared here.
  @@index([schoolId])
  @@index([teacherUserId])
}

model CalendarEvent {
  id              String                @id @default(uuid())
  schoolId        String
  school          School                @relation(fields: [schoolId], references: [id])
  title           String
  description     String?
  category        CalendarEventCategory @default(OTHER)
  startsAt        DateTime
  endsAt          DateTime
  allDay          Boolean               @default(false)
  // Null means the whole school; set means the event only concerns one class.
  classId         String?
  class           SchoolClass?          @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdByUser   User                  @relation("CalendarEventAuthor", fields: [createdByUserId], references: [id])
  createdAt       DateTime              @default(now())

  @@index([schoolId, startsAt])
  @@index([classId])
}

enum LeaveKind {
  CASUAL
  SICK
  UNPAID
  MATERNITY
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  // Withdrawn by the requester before anyone acted on it.
  CANCELLED
}

// A staff member asking for time off. Requester is a User rather than a
// TeacherProfile because school admins take leave too.
model LeaveRequest {
  id               String      @id @default(uuid())
  schoolId         String
  school           School      @relation(fields: [schoolId], references: [id])
  requesterUserId  String
  requesterUser    User        @relation("LeaveRequester", fields: [requesterUserId], references: [id])
  kind             LeaveKind
  startDate        DateTime
  endDate          DateTime
  reason           String?
  status           LeaveStatus @default(PENDING)
  reviewedByUserId String?
  reviewedByUser   User?       @relation("LeaveReviewer", fields: [reviewedByUserId], references: [id])
  reviewedAt       DateTime?
  reviewNote       String?
  createdAt        DateTime    @default(now())

  @@index([schoolId, status])
  @@index([requesterUserId])
}

// A slot a teacher offers for parent meetings. Booking is represented by the
// nullable parent/student columns rather than a separate Booking table: a slot
// holds at most one meeting, so a second table would only add a join and the
// chance of two bookings existing for one slot.
model MeetingSlot {
  id                   String    @id @default(uuid())
  schoolId             String
  school               School    @relation(fields: [schoolId], references: [id])
  teacherUserId        String
  teacherUser          User      @relation("MeetingTeacher", fields: [teacherUserId], references: [id], onDelete: Cascade)
  startsAt             DateTime
  endsAt               DateTime
  bookedByParentUserId String?
  bookedByParentUser   User?     @relation("MeetingParent", fields: [bookedByParentUserId], references: [id], onDelete: SetNull)
  // Which child the meeting is about — a parent with two children at the
  // school needs the teacher to know which one.
  studentId            String?
  student              StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  bookedAt             DateTime?
  note                 String?
  createdAt            DateTime  @default(now())

  // A teacher can't offer two slots starting at the same moment.
  @@unique([teacherUserId, startsAt])
  @@index([schoolId, startsAt])
  @@index([bookedByParentUserId])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  // Waiting on the school to answer a question — distinct from OPEN so the
  // platform queue doesn't show work that isn't actionable.
  WAITING_ON_SCHOOL
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// A school asking the platform owner for help. One tier above Complaint,
// which is a parent asking a school.
model SupportTicket {
  id             String                 @id @default(uuid())
  schoolId       String
  school         School                 @relation(fields: [schoolId], references: [id])
  raisedByUserId String
  raisedByUser   User                   @relation("SupportRaiser", fields: [raisedByUserId], references: [id])
  subject        String
  body           String
  status         SupportTicketStatus    @default(OPEN)
  priority       SupportTicketPriority  @default(NORMAL)
  resolvedAt     DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  comments SupportTicketComment[]

  @@index([status, priority])
  @@index([schoolId])
}

model SupportTicketComment {
  id           String        @id @default(uuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorUserId String
  authorUser   User          @relation("SupportCommenter", fields: [authorUserId], references: [id])
  body         String
  // Platform-side working notes. Never returned to the school — see the
  // service, which filters on this rather than relying on the caller.
  internal     Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([ticketId])
}

// A message from the platform owner to every tenant — maintenance windows,
// new features, billing changes. Distinct from Notice, which is one school
// talking to its own community.
model PlatformBroadcast {
  id                String   @id @default(uuid())
  title             String
  body              String
  // Empty means everyone. Otherwise only these roles see it, so a billing
  // notice can go to school admins without reaching parents.
  audienceRoles     Role[]
  publishedByUserId String
  publishedByUser   User     @relation("BroadcastAuthor", fields: [publishedByUserId], references: [id])
  // Null means it stays up until withdrawn. A dated maintenance notice should
  // disappear on its own rather than needing someone to remember.
  expiresAt         DateTime?
  createdAt         DateTime @default(now())

  @@index([expiresAt])
}

// A file a teacher publishes to a class — notes, a worksheet, a past paper.
//
// Distinct from an assignment attachment: material has no due date and nobody
// submits anything back. Before this, the only way to get a PDF to a class was
// to invent an assignment for it.
model StudyMaterial {
  id               String      @id @default(uuid())
  schoolId         String
  school           School      @relation(fields: [schoolId], references: [id])
  classId          String
  class            SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject          String
  title            String
  description      String?
  // The storage layer's own fields, kept together: `fileKey` is what the
  // provider was given, `fileUrl` what it handed back. Keeping the key means a
  // Supabase URL can be re-signed later without guessing at the object name.
  fileKey          String
  fileUrl          String
  contentType      String
  sizeBytes        Int
  uploadedByUserId String
  uploadedByUser   User        @relation("StudyMaterialUploader", fields: [uploadedByUserId], references: [id])
  createdAt        DateTime    @default(now())

  @@index([schoolId])
  @@index([classId, subject])
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  // Ran out of time. Graded on whatever the student had saved, which is why
  // answers are saved as they are chosen rather than all at once at the end.
  EXPIRED
}

// A multiple-choice quiz set against one class and subject.
//
// Draft until `publishedAt` is set: a half-written paper visible to students
// is worse than no paper, and questions can only change while it is a draft.
model Quiz {
  id               String    @id @default(uuid())
  schoolId         String
  school           School    @relation(fields: [schoolId], references: [id])
  classId          String
  class            SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject          String
  title            String
  instructions     String?
  // Null means untimed. When set, the deadline for an attempt is computed from
  // this at the moment the attempt starts and stored on the attempt, so
  // changing the limit later can't retroactively fail someone mid-paper.
  timeLimitMinutes Int?
  opensAt          DateTime?
  closesAt         DateTime?
  maxAttempts      Int       @default(1)
  publishedAt      DateTime?
  // Where an auto-graded score lands in the gradebook. Both null keeps the
  // quiz out of it entirely — a practice paper shouldn't touch a report card.
  gradeTerm        String?
  gradeExamType    String?
  createdByUserId  String
  createdByUser    User      @relation("QuizAuthor", fields: [createdByUserId], references: [id])
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]

  // Two quizzes claiming the same gradebook cell would have one silently
  // overwrite the other's marks. Postgres treats nulls as distinct, so quizzes
  // that stay out of the gradebook never collide here.
  @@unique([classId, subject, gradeTerm, gradeExamType])
  @@index([schoolId])
  @@index([classId, publishedAt])
}

model QuizQuestion {
  id           String  @id @default(uuid())
  quizId       String
  quiz         Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt       String
  options      String[]
  correctIndex Int
  marks        Decimal @default(1) @db.Decimal(6, 2)
  sortOrder    Int

  answers QuizAnswer[]

  @@unique([quizId, sortOrder])
}

model QuizAttempt {
  id            String            @id @default(uuid())
  schoolId      String
  school        School            @relation(fields: [schoolId], references: [id])
  quizId        String
  quiz          Quiz              @relation(fields: [quizId], references: [id], onDelete: Cascade)
  studentId     String
  student       StudentProfile    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  attemptNumber Int
  status        QuizAttemptStatus @default(IN_PROGRESS)
  startedAt     DateTime          @default(now())
  // Fixed by the server when the attempt starts. The client's clock never
  // decides whether a paper is still open.
  expiresAt     DateTime?
  submittedAt   DateTime?
  score         Decimal?          @db.Decimal(6, 2)
  maxScore      Decimal?          @db.Decimal(6, 2)

  answers QuizAnswer[]

  // Makes "start a second attempt" a database-level claim rather than a
  // read-then-write, so a double tap can't open two papers at once.
  @@unique([quizId, studentId, attemptNumber])
  @@index([schoolId])
  @@index([studentId])
}

model QuizAnswer {
  id            String       @id @default(uuid())
  attemptId     String
  attempt       QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId    String
  question      QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedIndex Int
  // Filled at grading, not at save. A student changing their mind must not be
  // able to learn from the response whether the last choice was right.
  isCorrect     Boolean?
  marksAwarded  Decimal?     @db.Decimal(6, 2)
  answeredAt    DateTime     @default(now())

  @@unique([attemptId, questionId])
  @@index([questionId])
}

enum SyllabusTopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

// One item on the syllabus for a class, subject and term.
//
// The tracker is the list of these plus their status: coverage is derived, not
// stored, so it can never disagree with the topics it is meant to summarise.
model SyllabusTopic {
  id              String              @id @default(uuid())
  schoolId        String
  school          School              @relation(fields: [schoolId], references: [id])
  classId         String
  class           SchoolClass         @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject         String
  term            String
  title           String
  description     String?
  // Explicit ordering: a syllabus has a taught order that is not alphabetical
  // and not the order somebody happened to type it in.
  sortOrder       Int
  status          SyllabusTopicStatus @default(NOT_STARTED)
  // When the teacher means to cover it, against when they actually did. Both
  // nullable — a syllabus with no dates is still a syllabus.
  plannedForDate  DateTime?
  completedOn     DateTime?
  createdByUserId String
  createdByUser   User                @relation("SyllabusAuthor", fields: [createdByUserId], references: [id])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  lessons LessonPlan[]

  // The same topic listed twice in one term is a typo, not a plan.
  @@unique([classId, subject, term, title])
  @@index([schoolId])
  @@index([classId, subject, term])
}

// A single lesson a teacher intends to teach: what it is for, what happens in
// it, what they need to hand.
//
// Optionally pinned to a syllabus topic and to a period, so "did we cover it"
// and "when" answer from the same record.
model LessonPlan {
  id            String         @id @default(uuid())
  schoolId      String
  school        School         @relation(fields: [schoolId], references: [id])
  classId       String
  class         SchoolClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject       String
  topicId       String?
  topic         SyllabusTopic? @relation(fields: [topicId], references: [id], onDelete: SetNull)
  title         String
  objectives    String?
  activities    String?
  resources     String?
  date          DateTime
  periodId      String?
  period        Period?        @relation(fields: [periodId], references: [id], onDelete: SetNull)
  teacherUserId String
  teacherUser   User           @relation("LessonPlanTeacher", fields: [teacherUserId], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([schoolId])
  @@index([classId, date])
  @@index([teacherUserId, date])
  @@index([topicId])
}

// A scheduled online lesson: a link, a time, and the class it is for.
//
// Deliberately not a video stack. Schools already have Zoom, Meet or Teams;
// what they lack is somewhere the right link reaches the right class at the
// right time, which is all this is.
model LiveClass {
  id         String      @id @default(uuid())
  schoolId   String
  school     School      @relation(fields: [schoolId], references: [id])
  classId    String
  class      SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject    String
  title      String
  // Held back from students outside the join window by the service, so a link
  // can't be shared around before the lesson or reused after it.
  meetingUrl String
  startsAt   DateTime
  endsAt     DateTime
  hostUserId String
  hostUser   User        @relation("LiveClassHost", fields: [hostUserId], references: [id])
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // A class can't be in two live lessons starting at the same instant. This
  // catches the double-submit that creates a duplicate; genuine overlaps at
  // different start times are the timetable's problem, not this table's.
  @@unique([classId, startsAt])
  @@index([schoolId, startsAt])
  @@index([hostUserId, startsAt])
}
