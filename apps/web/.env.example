# Base URL of the Skolara API. Must be reachable from the browser, not just
# from the server — this is baked into the client bundle at build time.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# Show every module in the sidebar, including those deferred until after the
# MVP (hostel, inventory, payroll, quizzes, ...). Leave unset in production.
# NEXT_PUBLIC_SHOW_ALL_MODULES="true"
