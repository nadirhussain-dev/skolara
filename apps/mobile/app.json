{
  "expo": {
    "name": "Skolara",
    "slug": "skolara",
    "scheme": "skolara",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "backgroundColor": "#3730A3",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3730A3"
    },
    "plugins": [
      "expo-router",
      "expo-notifications"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.skolara.app"
    },
    "android": {
      "package": "com.skolara.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3730A3"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    },
    "notification": {
      "icon": "./assets/adaptive-icon.png",
      "color": "#3730A3"
    },
    "description": "Skolara for parents, students, teachers and school owners."
  }
}
