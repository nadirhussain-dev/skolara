# Base URL of the Skolara API.
#
# `localhost` resolves to the device itself on a phone or emulator, not to your
# machine — use your LAN IP (e.g. http://192.168.1.20:4000) when running on a
# real handset, or http://10.0.2.2:4000 on the Android emulator.
EXPO_PUBLIC_API_URL="http://localhost:4000"
